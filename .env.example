MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net
NEXTAUTH_URL=https://app.voidkin.world
NEXTAUTH_SECRET=run: openssl rand -base64 32
GOOGLE_CLIENT_ID=from Google Cloud Console > Credentials (redirect: https://app.voidkin.world/api/auth/callback/google)
GOOGLE_CLIENT_SECRET=
# Account-level xpub (m/44'/60'/0'/0) of your cold master seed. Only the PUBLIC key lives on the server.
MASTER_XPUB=
BSC_RPC=https://bsc-dataseed.binance.org
# --- Stage 2 ---
ADMIN_EMAILS=you@gmail.com            # who can open /admin (comma separated)
MIN_DEPOSIT=5                         # deposit worker: smaller USDT deposits are not credited
# Signer worker ONLY (never on Vercel):
HOT_WALLET_PRIVATE_KEY=
# Hedge worker ONLY (Binance key: spot trading ON, withdrawals OFF, IP-restricted):
BINANCE_KEY=
BINANCE_SECRET=
HEDGE_LIVE=0                          # 0 = log only, 1 = place real Binance orders
BINANCE_API=https://api.binance.com   # use a region-allowed endpoint if blocked
TOTP_KEY=                             # 64 hex chars: openssl rand -hex 32 (encrypts 2FA secrets; keep it safe and never change it)
